FINAL_REPORT_MODEL=openai/gpt-oss-120b
FINAL_REPORT_BASE_URL=https://api.groq.com/openai/v1
FINAL_REPORT_API_KEY=c6deba402e324b86bc6737d6cefe7bee
# --- AssemblyAI (required) ---
# Get a key from https://www.assemblyai.com/dashboard/home
ASSEMBLYAI_API_KEY="c6deba402e324b86bc6737d6cefe7bee"
ASSEMBLYAI_STREAMING_MODEL=universal-3-5-pro
STREAMING_SAMPLE_RATE=24000

# Optional: pin the backend to an agent you already created yourself instead of letting it
# auto-provision/update one. Leave blank in normal use.
ASSEMBLYAI_AGENT_ID=""

# Voice used for the agent's TTS output. If this id isn't valid, agent creation fails with
# a 400 listing the valid voices - check the Voices page in the AssemblyAI docs.
AGENT_VOICE=anna

# --- Reasoning LLM: Groq ---
# Get a key from https://console.groq.com/keys
# Leave GROQ_API_KEY blank to fall back to AssemblyAI's own managed reasoning model.
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- Cloud infra tools ---
# true  = use built-in mock infra responses (default, no cloud creds needed, safe to demo)
# false = call the live path in app/tools/infra.py (you wire this up yourself)
USE_MOCK_CLOUD=true



# --- MeetingBaaS ---
MEETING_BAAS_KEY="mb-wLEzzQLTfqZIalWQkvJPHVShgdCuDhKgYqVIOpSIKrhADYHudckdIgRMZMYAm"
MEETING_BAAS_API_BASE_URL=https://api.meetingbaas.com/v2
# Use an HTTPS URL reachable from the public internet. It is converted to WSS for audio streaming.
# For local testing, use a tunnel such as ngrok or Cloudflare Tunnel.
PUBLIC_BASE_URL="https://resistance-handed-montana-explaining.trycloudflare.com"

# --- Server ---
# Comma-separated list of origins allowed to hit the REST/WS API (your dashboard)
CORS_ORIGINS=http://localhost:3000
HOST=0.0.0.0
PORT=8000
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/google/callback"
GOOGLE_SCOPES="https://www.googleapis.com/auth/calendar.app.created"