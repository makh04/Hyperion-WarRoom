FINAL_REPORT_MODEL=openai/gpt-oss-120b
FINAL_REPORT_BASE_URL=https://api.groq.com/openai/v1
FINAL_REPORT_API_KEY=""
# --- AssemblyAI (required) ---
# Get a key from https://www.assemblyai.com/dashboard/home
ASSEMBLYAI_API_KEY=""
ASSEMBLYAI_STREAMING_MODEL=universal-3-5-pro
STREAMING_SAMPLE_RATE=24000



AGENT_VOICE=anna

# Leave GROQ_API_KEY blank to fall back to AssemblyAI's own managed reasoning model.
GROQ_API_KEY=""
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL="openai/gpt-oss-120b"




# --- Cloud infra tools ---
# true  = use built-in mock infra responses (default, no cloud creds needed, safe to demo)
# false = call the live path in app/tools/infra.py (you wire this up yourself)
USE_MOCK_CLOUD=true



# --- MeetingBaaS ---
MEETING_BAAS_KEY=""
MEETING_BAAS_API_BASE_URL=https://api.meetingbaas.com/v2
PUBLIC_BASE_URL="your_public_url"


# Comma-separated list of origins allowed to hit the REST/WS API (your dashboard)
CORS_ORIGINS=http://localhost:3000
HOST=0.0.0.0
PORT=8000
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/google/callback"
GOOGLE_SCOPES="https://www.googleapis.com/auth/calendar.app.created"
